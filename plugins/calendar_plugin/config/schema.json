{"$schema": "http://json-schema.org/draft-07/schema#", "title": "Calendar Plugin Config", "type": "object", "properties": {"default_provider": {"type": "string", "enum": ["ics", "google", "outlook"], "default": "ics"}, "reminder_minutes": {"type": "integer", "minimum": 0, "maximum": 1440, "default": 15}, "timezone": {"type": "string", "default": "UTC"}, "auto_approve": {"type": "boolean", "default": false}, "max_results": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}, "working_hours_start": {"type": "string", "pattern": "^\\d{2}:\\d{2}$", "default": "09:00"}, "working_hours_end": {"type": "string", "pattern": "^\\d{2}:\\d{2}$", "default": "17:00"}, "ics_path": {"type": "string"}, "google": {"type": "object", "properties": {"client_secrets_path": {"type": "string"}, "token_path": {"type": "string"}}, "required": ["client_secrets_path", "token_path"]}, "outlook": {"type": "object", "properties": {"client_id": {"type": "string"}, "tenant_id": {"type": "string"}, "client_secret": {"type": "string"}, "token_path": {"type": "string"}}, "required": ["client_id", "tenant_id", "client_secret", "token_path"]}}, "required": ["default_provider"]}
